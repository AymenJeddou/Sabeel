# Shared config (Sprint1_Action_Plan.md, Section 4.6) — one source of truth.
# Nobody hardcodes a value that's on this list. Copy to .env and fill in real values locally.

# WP3 — Core API. Local dev matches docker-compose.yml's `db` service.
# Host port is 5433, not 5432, to avoid clashing with a native Postgres install.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/roadscan

# WP1 — Vision model. Path to the exported pothole_model.onnx.
MODEL_PATH=models/pothole_model.onnx

# WP2 — RAG agent. Path to the on-disk Chroma vector store.
CHROMA_DB_PATH=rag-service/chroma_db

# WP2 — RAG agent. Free-tier LLM call via Hugging Face's Inference Providers API.
# Verify both availability AND latency for your own token before trusting these
# defaults -- serverless provider support shifts over time. As of integration
# testing (2026-09-22): Qwen2.5-7B-Instruct and Llama-3.2-3B-Instruct were NOT
# supported by any enabled provider; Qwen2.5-72B-Instruct worked but
# consistently exceeded a 12s budget; Llama-3.1-8B-Instruct responded in
# 4.5-7.6s with valid citations, hence it's primary here.
HF_API_TOKEN=
HF_MODEL_PRIMARY=meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_BACKUP=Qwen/Qwen2.5-72B-Instruct

# WP3 — Core API. Where the RAG service (its own process/container) is reachable.
# The Core API calls this over HTTP; it never imports the RAG service in-process
# (keeps its heavy deps -- torch, chromadb, sentence-transformers -- out of the
# Core API's container).
RAG_SERVICE_URL=http://localhost:8001
RAG_TIMEOUT_S=15

# WP3 — de-duplication radius in meters. Must match the goals table (Cahier_de_charges.md, Section 2).
MAX_DEDUP_DISTANCE_M=5

# WP3 — minimum score that triggers WP2's generate() call.
SCORE_THRESHOLD_FOR_SHEET=3

# WP-T — deployment.
PORT=8000
CLOUD_RUN_SERVICE_NAME=roadscan-api
