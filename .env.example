# Shared configuration, one source of truth. Copy to .env and fill in real values.
# Every variable maps to a field of backend/app/config.py (same name, lower case).

# --- Core API: database ------------------------------------------------------
# Local dev: docker-compose `db` is on 5433 (avoids a native Postgres on 5432).
# Production: the Supabase connection string (Session pooler, asyncpg driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/roadscan
# Tests use their own database (created and wiped automatically). Defaults to
# DATABASE_URL with the database name `sabeel_test`.
# TEST_DATABASE_URL=

# --- Vision model (WP1) ------------------------------------------------------
MODEL_PATH=models/pothole_model.onnx
# Confidence threshold tuned on the validation split (test_metrics.json).
CONF_THRESHOLD=0.28
# Detection gate for POST /reports: below this, the report waits for review.
MIN_CONFIDENCE=0.28
# ONNX Runtime threads; 0 = all cores. Set to the vCPU count on Cloud Run.
ONNX_INTRA_OP_THREADS=0

# --- RAG service (WP2) -------------------------------------------------------
CHROMA_DB_PATH=rag-service/chroma_db
HF_API_TOKEN=
HF_MODEL_PRIMARY=meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_BACKUP=Qwen/Qwen2.5-72B-Instruct
RAG_SERVICE_URL=http://localhost:8001
RAG_TIMEOUT_S=30

# --- Reports, potholes, confirmations ----------------------------------------
MAX_DEDUP_DISTANCE_M=5
SCORE_THRESHOLD_FOR_SHEET=3
MIN_DISTINCT_DEVICES_TO_CONFIRM=2
MAX_UPLOAD_MB=8
MAX_REPORT_AGE_DAYS=7
REOPEN_WINDOW_DAYS=90
CONFIRM_RADIUS_M=50
MAX_CONFIRM_GPS_ACCURACY_M=40
REOPEN_MIN_DEVICES=2
NOT_POTHOLE_MIN_DEVICES=2

# --- Security ----------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser (dashboard, PWA).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret for /internal/* (the scheduler). Empty disables those routes.
INTERNAL_TOKEN=
RATE_LIMITS_ENABLED=true

# --- Photos ------------------------------------------------------------------
# local (backend/app/static/photos) | supabase (required on Cloud Run)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=photos
BLUR_FACES_AND_PLATES=true

# --- Background jobs ---------------------------------------------------------
JOB_MAX_ATTEMPTS=5
# Seconds between worker passes inside the API. 0 on Cloud Run (use the scheduler).
JOB_LOOP_INTERVAL_S=20

# --- OpenStreetMap, routing, weather (free, no key) ---------------------------
OSM_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=Sabeel/1.0 (pothole reporting, Tunisia; github.com/AymenJeddou/Sabeel)
DEFAULT_OFFICE_CODE=mun-tunis
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
RAIN_ALERT_MM=10

# Printed on PDFs and QR codes (the dashboard / public site URL).
PUBLIC_BASE_URL=http://localhost:5173

# --- Deployment --------------------------------------------------------------
PORT=8000
CLOUD_RUN_SERVICE_NAME=sabeel-api
