flowchart LR
    subgraph Client["Mobile app — Flutter (WP4)"]
        CAM["Camera capture"]
        LOC["Location service<br/>GPS · speed · heading"]
        QUEUE["Offline queue"]
        MAPUI["Map screen<br/>flutter_map + OSM"]
        LIST["My reports screen"]
