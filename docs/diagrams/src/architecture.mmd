        SEV["severity_scoring.py"]
        MODEL[("pothole_model.onnx")]
    end

    subgraph RAG["RAG service — FastAPI (WP2)"]
        ROAD["Road-type resolver"]
        RETR["Retriever top-5"]
        GEN["LLM generation +<br/>fallback template"]
        GUARD["Citation guard"]
        CHROMA[("Chroma<br/>road_rules_v1")]
    end

    DB[(" Supabase / PostgreSQL<br/>+ PostGIS")]
    HF["Hugging Face<br/>Inference API"]
