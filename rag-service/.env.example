# Copy to .env and fill in real values. Never commit .env.
HF_API_TOKEN=hf_your_token_here
HF_MODEL_PRIMARY=meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_BACKUP=Qwen/Qwen2.5-72B-Instruct
# Verify model availability AND latency with your own token before relying on
# this list -- HF free-tier serverless Inference Providers support (and
# latency) shifts over time. As of Sprint 1 (2026-09-19): Qwen2.5-7B-Instruct
# and Llama-3.2-3B-Instruct were NOT supported by any enabled provider for
# this token. Qwen2.5-72B-Instruct, Qwen2.5-Coder-32B-Instruct, and
# Llama-3.1-8B-Instruct all worked, but Qwen2.5-72B-Instruct consistently
# took >12s (our LLM_TIMEOUT_S), tripping the template fallback every time,
# while Llama-3.1-8B-Instruct responded in ~4.5s with valid citations -- hence
# the smaller/faster model is primary here, not the "smarter" one.
CHROMA_DB_PATH=./chroma_db
MIN_SIMILARITY=0.35
TOP_K_RETRIEVE=5
TOP_K_SHOWN=3
LLM_TIMEOUT_S=12
PORT=8001
