# Copy to .env and fill in real values. Never commit .env.

# Option A: Hugging Face Inference Providers (default).
HF_API_TOKEN=hf_your_token_here
HF_MODEL_PRIMARY=meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_BACKUP=Qwen/Qwen2.5-72B-Instruct

# Option B: any OpenAI-compatible endpoint (overrides option A when set),
# e.g. Groq's free tier:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant
# LLM_MODEL_BACKUP=llama-3.3-70b-versatile

CHROMA_DB_PATH=./chroma_db
MIN_SIMILARITY=0.35
TOP_K_RETRIEVE=8
TOP_K_SHOWN=4
# Sheets are generated in a background job: 20 s keeps the cahier's < 20 s target.
LLM_TIMEOUT_S=20
PORT=8001
